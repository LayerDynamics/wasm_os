{
  "name": "wasm_os",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "tools/binder"],
  "scripts": {
    "binder": "node tools/binder/binder.mjs",
    "binder:check": "node tools/binder/binder.mjs check",
    "build:kernel": "cargo component build --release -p kernel --target wasm32-unknown-unknown",
    "build": "npm run build:kernel && npm run binder gen",
    "test:rust": "cargo test -p kernel",
    "test:host": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run binder:check && npm run test:rust && npm run test:host && npm run test:e2e"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.4.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.48.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
