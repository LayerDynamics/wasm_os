package wasmos:abi@0.1.0;

interface control {
  /// Backends a path can be mounted on.
  enum backend { tmpfs, opfs, idb }

  record proc-info {
    pid: u32,
    name: string,
    state: string,
    /// Scheduling priority (FR-8) and accounting for `ps`/`top` (FR-33).
    priority: u8,
    /// Scheduler ticks accounted (one per serviced syscall) — a deterministic
    /// kernel-activity metric (not literal CPU%).
    cpu-ticks: u64,
    /// Reported guest memory size in bytes (0 until the worker reports it).
    mem-bytes: u32,
    /// Parent pid, or 0 for a host-spawned root.
    parent: u32,
  }

  record feature-report {
    shared-array-buffer: bool,
    cross-origin-isolated: bool,
    opfs: bool,
    jspi: bool,
    tier: string,           // "A" (SAB) | "B" (cooperative)
  }

  record boot-status {
    ready: bool,
    boot-millis: u32,
    features: feature-report,
  }

  variant fs-error { not-found, io-failure(string), bad-path(string) }

  /// Bring the kernel to ready; idempotent. Host passes the detected features.
  boot: func(features: feature-report) -> boot-status;

  /// Mount a backend at a path prefix. The host must already have bound the
  /// matching blockstore import for opfs/idb backends.
  mount: func(path: string, on: backend) -> result<_, fs-error>;

  // --- VFS operations (exercised by the kernel/VFS bootstrap integration + E2E tests) ---
  fs-write:  func(path: string, bytes: list<u8>) -> result<_, fs-error>;
  fs-read:   func(path: string) -> result<list<u8>, fs-error>;
  fs-list:   func(path: string) -> result<list<string>, fs-error>;
  /// Remove a file. Returns not-found if the path does not exist. Routes to the
  /// backing store for opfs/idb mounts (durable unlink) and to tmpfs otherwise.
  fs-delete: func(path: string) -> result<_, fs-error>;
  /// Create a directory and all missing parents (`mkdir -p`); idempotent. Used to
  /// build the standard filesystem hierarchy at boot.
  fs-mkdirp: func(path: string) -> result<_, fs-error>;
  /// Seed the /dev/[u]random generator with real host CSPRNG entropy (the kernel is
  /// deterministic and has no RNG of its own). Called once at boot.
  seed-entropy: func(seed: list<u8>);

  // --- Process lifecycle (WASI process runtime, FR-5) ---
  record spawn-spec {
    name: string,
    /// Filesystem subtree granted to the child (rights = read+write). Empty
    /// string grants no FS capability. WASI process runtime has no shm/net/signal grants.
    grant-fs-subtree: string,
    grant-spawn: bool,
    /// Grant the Gpu capability — required to request a compositor surface
    /// (`win_surface`, desktop compositor). Default-deny: a process without it cannot draw.
    grant-gpu: bool,
    /// Grant the Input capability — required to receive brokered keyboard/mouse
    /// for its focused window (brokered input). Default-deny.
    grant-input: bool,
    /// Grant the Signal capability — process-control authority (the `kill`
    /// builtin signals other processes, signals). Default-deny; the shell holds it.
    grant-signal: bool,
    /// Grant the Net capability — brokered networking (the `fetch` coreutil, network broker).
    /// Default-deny; the shell holds it and delegates it to `fetch`.
    grant-net: bool,
  }

  /// Allocate a process: PID + per-process fd table (0/1/2 preopened) + capset.
  /// Does NOT execute anything — the host (kworker) creates the worker and runs
  /// the guest, then drives syscalls in via service-syscall.
  spawn: func(spec: spawn-spec) -> u32;

  /// Register the privileged emulator process (Linux guest integration, FR-27/FR-28): a Native process
  /// (Gpu+Input+Net+FS caps) that runs its own CPU loop in a dedicated host worker
  /// — never pumped by the ring, but a first-class killable PID in proc-list.
  /// Returns its pid; the host then creates the emulator worker and boots it.
  spawn-emulator: func(name: string) -> u32;

  /// Account a run-to-budget quantum for the emulator (emulator CPU accounting, FR-28). Its worker
  /// reports periodic wall-budget heartbeats so its CPU activity shows in `top`
  /// (it makes no syscalls). Ignored for any pid that is not the emulator.
  account-emulator: func(pid: u32, ticks: u64);

  /// A child the kernel registered (via guest spawn) that the kworker must now
  /// instantiate: load `image-path` from the VFS and create its worker + ring.
  record spawn-request {
    pid: u32,
    image-path: string,
    /// True when the child's fd 0 is the interactive terminal (a foreground job,
    /// e.g. a bare command or a pipeline's first stage). The host pushes such a
    /// child onto the terminal's foreground stack so keystrokes route to it (not
    /// the shell, which is blocked in `wait`), and pops it when the child exits.
    terminal-stdin: bool,
  }

  /// Outcome of routing one syscall (shell and userland park/resume).
  record syscall-outcome {
    /// `none` => the syscall PARKED: the kworker keeps the request bytes and
    /// does NOT complete the ring; the guest stays blocked until a later wakeup
    /// re-drives it. `some(bytes)` => the binary response to write to the ring.
    reply: option<list<u8>>,
    /// pids whose parked syscalls are now runnable; the kworker re-drives each
    /// (iterative, de-duplicated) with its stashed request.
    wakeups: list<u32>,
    /// bytes a terminal-bound fd produced during this syscall, streamed to the
    /// terminal by the kworker (empty until a process binds a terminal fd).
    term-output: list<u8>,
    /// set when a guest spawned a child — the kworker brings it to life.
    spawn: option<spawn-request>,
    /// pids the kworker must force-terminate (SIGKILL, signals): the kernel has
    /// already zombified them; the host tears down their worker + ring.
    reap: list<u32>,
    /// set when the caller parked on `net_request` (network broker): the kworker performs
    /// the brokered fetch and returns the body via `deliver-net`.
    net: option<net-request>,
    /// set when the caller changed the terminal line-discipline mode via
    /// `tty_set_raw` (in-terminal editors like nano): `some(1)` => raw (no echo,
    /// no line buffering, ESC/control bytes passed through), `some(0)` => cooked.
    /// The kworker forwards the new mode to the host terminal. `none` => no change.
    term-mode: option<u8>,
  }

  /// A capability-gated network request the kworker must broker (network broker, OQ-2).
  record net-request {
    pid: u32,
    url: string,
  }

  /// Deliver a brokered fetch response to a parked `net_request` caller (network broker).
  /// `ok` false signals a fetch failure (the guest sees errno IO). Returns the
  /// pids whose parked requests are now runnable.
  deliver-net: func(pid: u32, ok: bool, body: list<u8>) -> list<u32>;

  /// Route one WASI Preview 1 (or wasmos_kernel) syscall for `pid`. `request`
  /// is the binary wire format (see crates/kernel/src/syscall.rs). All
  /// guest-memory marshalling has ALREADY been done host-side; this sees only
  /// resolved values. proc-exit is encoded here and transitions the proc.
  service-syscall: func(pid: u32, request: list<u8>) -> syscall-outcome;

  /// Deliver input bytes to a process's stdin (terminal keystrokes). Returns the
  /// pids whose parked stdin reads are now runnable.
  deliver-stdin: func(pid: u32, bytes: list<u8>) -> list<u32>;

  /// Result of attempting to deliver one brokered input batch. `accepted` is
  /// false when the target lacks the Input capability or no longer exists.
  record input-delivery {
    accepted: bool,
    wakeups: list<u32>,
  }

  /// Deliver brokered input events (keyboard/mouse, fixed-size records) to the
  /// process owning the focused window (brokered input, FR-25). Returns whether
  /// the batch was accepted and the pids whose parked `win_read_input` calls are
  /// now runnable. Default-deny: events without the Input capability are dropped.
  deliver-input: func(pid: u32, bytes: list<u8>) -> input-delivery;

  /// Bind a process's stdout/stderr to the interactive terminal: subsequent
  /// writes stream out as `syscall-outcome.term-output` (shell and userland).
  bind-terminal: func(pid: u32);

  /// Record a process's reported guest memory size (process control and IPC `top`), from the worker.
  set-proc-mem: func(pid: u32, bytes: u32);

  /// Change a process's scheduling priority at runtime (FR-8).
  set-priority: func(pid: u32, priority: u8);

  /// Has the process exited? Returns the exit code if it is a zombie.
  exit-code: func(pid: u32) -> option<s32>;

  /// Read and clear a process's captured stdout/stderr (host surfaces output).
  take-capture: func(pid: u32) -> tuple<list<u8>, list<u8>>;

  /// Process table view. Reports running/zombie processes with their state.
  list-procs: func() -> list<proc-info>;
}
