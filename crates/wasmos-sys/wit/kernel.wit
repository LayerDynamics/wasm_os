package wasmos:kernel@0.1.0;

/// The wasmos_kernel process-control extension (M2) — the guest syscall surface
/// beyond WASI Preview 1. The shell uses these to run pipelines. Transported
/// over the SAB syscall ring (opcodes 0x20.. in crates/kernel/src/syscall.rs);
/// the guest stubs live in crates/wasmos-sys/src/lib.rs and the host shim
/// provides the matching `wasmos_kernel.syscall` import. This world is the
/// documented source of truth; `binder kernel-check` verifies crates/wasmos-sys
/// exposes a matching `spawn` / `pipe` / `wait` (FR-36). It lives outside the
/// kernel component's `wit/` tree (which is a single `wasmos:abi` package) on
/// purpose — it is not consumed by `cargo-component`/`jco`.
interface process {
  /// How a child's stdio fd (0/1/2) is wired.
  variant stdio {
    terminal,
    pipe-read(u32),
    pipe-write(u32),
    file(file-redirect),
  }
  record file-redirect {
    path: string,
    write: bool,
  }

  /// Spawn a child from a VFS image with argv + stdio + working directory;
  /// returns the child PID.
  spawn: func(path: string, argv: list<string>, stdio: tuple<stdio, stdio, stdio>, cwd: string) -> result<u32, u16>;

  /// Create a pipe; returns (read-fd, write-fd, pipe-id). The fds are the
  /// caller's ends; the id is used in a child's stdio spec.
  pipe: func() -> result<tuple<u32, u32, u32>, u16>;

  /// Wait for a child to exit; returns its exit code (blocks until it exits).
  wait: func(pid: u32) -> result<s32, u16>;
}

/// The wasmos_kernel compositor extension (M3) — the guest surface + input
/// surface used by canvas apps (file manager, paint, editor, mandelbrot). Like
/// `process`, these are transported over the SAB syscall ring; `win-present` is
/// serviced host-side in the process worker (pixels never enter the ring). The
/// guest stubs live in crates/wasmos-sys/src/lib.rs; `binder kernel-check`
/// verifies a matching stub exists for each (FR-36).
interface compositor {
  /// A decoded brokered input event (12-byte wire record).
  record input-event {
    kind: u8,
    button: u8,
    x: u16,
    y: u16,
    key: u32,
    mods: u8,
  }

  /// Request a `width*height` RGBA canvas surface; returns its surface id. Needs
  /// the Gpu capability (default-deny).
  win-surface: func(width: u32, height: u32) -> result<u32, u16>;

  /// Publish a frame: `framebuffer` is `width*height*4` RGBA bytes in guest
  /// memory, copied into the surface's shared buffer and blitted by the host.
  win-present: func(surface-id: u32, framebuffer: list<u8>);

  /// Drain queued keyboard/mouse events for the focused window (blocks until some
  /// arrive). Needs the Input capability (default-deny).
  win-read-input: func() -> result<list<input-event>, u16>;
}

world shell-guest {
  import process;
}

world canvas-guest {
  import compositor;
}
