package wasmos:kernel@0.1.0;

/// The wasmos_kernel process-control extension (M2) — the guest syscall surface
/// beyond WASI Preview 1. The shell uses these to run pipelines. Transported
/// over the SAB syscall ring (opcodes 0x20.. in crates/kernel/src/syscall.rs);
/// the guest stubs live in crates/wasmos-sys/src/lib.rs and the host shim
/// provides the matching `wasmos_kernel.syscall` import. This world is the
/// documented source of truth; `binder kernel-check` verifies crates/wasmos-sys
/// exposes a matching `spawn` / `pipe` / `wait` (FR-36). It lives outside the
/// kernel component's `wit/` tree (which is a single `wasmos:abi` package) on
/// purpose — it is not consumed by `cargo-component`/`jco`.
interface process {
  /// How a child's stdio fd (0/1/2) is wired.
  variant stdio {
    terminal,
    pipe-read(u32),
    pipe-write(u32),
    file(file-redirect),
  }
  record file-redirect {
    path: string,
    write: bool,
  }

  /// Spawn a child from a VFS image with argv + stdio + working directory;
  /// returns the child PID.
  spawn: func(path: string, argv: list<string>, stdio: tuple<stdio, stdio, stdio>, cwd: string) -> result<u32, u16>;

  /// Create a pipe; returns (read-fd, write-fd, pipe-id). The fds are the
  /// caller's ends; the id is used in a child's stdio spec.
  pipe: func() -> result<tuple<u32, u32, u32>, u16>;

  /// Wait for a child to exit; returns its exit code (blocks until it exits).
  wait: func(pid: u32) -> result<s32, u16>;

  /// A live process-table entry (M4 `ps`/`top`, FR-33).
  record proc-info {
    pid: u32,
    name: string,
    state: u8,
    priority: u8,
    cpu-ticks: u64,
    mem-bytes: u32,
    parent: u32,
  }

  /// Snapshot the live process table (FR-33).
  proc-list: func() -> list<proc-info>;

  /// Renice a process (FR-8); reniceing another requires the Signal capability.
  set-priority: func(pid: u32, priority: u8) -> u16;

  /// Open/connect a named message channel (M4-T3). First opener creates it
  /// (endpoint 0); the second connects (endpoint 1). Returns (chan-id, end).
  chan-open: func(name: string) -> result<tuple<u32, u8>, u16>;

  /// Send one message to the peer endpoint (boundaries preserved).
  chan-send: func(chan-id: u32, msg: list<u8>) -> u16;

  /// Receive one message, blocking until one arrives; an empty result is EOF.
  chan-recv: func(chan-id: u32) -> result<list<u8>, u16>;

  /// Create a capability-gated shared-memory region of `size` bytes (M4-T4, FR-6).
  /// The caller owns it and is granted access. Returns the shm-id.
  shm-create: func(size: u32) -> result<u32, u16>;

  /// Confirm this process holds access to a region (granted by its owner).
  shm-map: func(shm-id: u32) -> u16;

  /// Copy up to `len` bytes from `off` in the region (needs granted access).
  shm-read: func(shm-id: u32, off: u32, len: u32) -> result<list<u8>, u16>;

  /// Copy `data` into the region at `off` (needs granted access).
  shm-write: func(shm-id: u32, off: u32, data: list<u8>) -> u16;

  /// Share access to a region this process owns with another process.
  shm-grant: func(shm-id: u32, target-pid: u32) -> u16;

  /// Send a signal to a process (M4-T5). SIGTERM (15) is catchable + cooperative;
  /// SIGKILL (9) is uncatchable + forceful. Signalling another process requires
  /// the Signal capability (self always allowed). Returns the kernel errno.
  kill: func(target-pid: u32, sig: u8) -> u16;

  /// Block until at least one signal is pending, then drain + return them
  /// (zero-CPU cooperative delivery). A guest loops on this to handle SIGTERM.
  sig-wait: func() -> list<u8>;

  /// Brokered network request (M5-T6, OQ-2): fetch `url` via the host and return
  /// the response body. Requires the Net capability (default-deny). Blocks until
  /// the fetch completes; an error result carries the kernel errno (IO on failure).
  net-request: func(url: string) -> result<list<u8>, u16>;
}

/// The wasmos_kernel compositor extension (M3) — the guest surface + input
/// surface used by canvas apps (file manager, paint, editor, mandelbrot). Like
/// `process`, these are transported over the SAB syscall ring; `win-present` is
/// serviced host-side in the process worker (pixels never enter the ring). The
/// guest stubs live in crates/wasmos-sys/src/lib.rs; `binder kernel-check`
/// verifies a matching stub exists for each (FR-36).
interface compositor {
  /// A decoded brokered input event (12-byte wire record).
  record input-event {
    kind: u8,
    button: u8,
    x: u16,
    y: u16,
    key: u32,
    mods: u8,
  }

  /// Request a `width*height` RGBA canvas surface; returns its surface id. Needs
  /// the Gpu capability (default-deny).
  win-surface: func(width: u32, height: u32) -> result<u32, u16>;

  /// Publish a frame: `framebuffer` is `width*height*4` RGBA bytes in guest
  /// memory, copied into the surface's shared buffer and blitted by the host.
  win-present: func(surface-id: u32, framebuffer: list<u8>);

  /// Drain queued keyboard/mouse events for the focused window (blocks until some
  /// arrive). Needs the Input capability (default-deny).
  win-read-input: func() -> result<list<input-event>, u16>;
}

world shell-guest {
  import process;
}

world canvas-guest {
  import compositor;
}
