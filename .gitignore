# Rust
/target
**/target
Cargo.lock.bak

# Node
node_modules
.npm
*.tsbuildinfo

# Build / generated artifacts (regenerated by `tools/binder gen`)
/dist
/build

# Generated WIT bindings — refreshed by `npm run build` and checked by Binder.
# The textual JS and TypeScript bindings are committed; the split-out core wasm
# payload remains ignored below with the other wasm build artifacts.

# cargo-component regenerates this from wit/ on every build
crates/kernel/src/bindings.rs
**/*.wasm
!wit/**/*.wasm
# Vendored MIT TinyEMU riscv64 core (M5) — committed third-party binary.
!third_party/tinyemu/*.wasm

# Zig compilation cache (build:guests:zig) — build output, not source
.zig-cache

# Test output
/playwright-report
/test-results
/coverage

# OS
.DS_Store

# Local-only / session + scratch
development/reference_only
.claude/

# Vite production build of the web client (build output)
apps/web/dist
.riscv-build/
CLAUDE.md
