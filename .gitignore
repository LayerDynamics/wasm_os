# Rust
/target
**/target
Cargo.lock.bak

# Node
node_modules
.npm
*.tsbuildinfo

# Build / generated artifacts (regenerated by `tools/binder gen`)
/dist
/build

# Generated WIT bindings — build output, regenerated by `npm run build` (binder gen).
# NOT committed: jco glue is not byte-reproducible across CPU arch (mac arm64 vs
# CI x86_64), so it is treated as a build artifact. The gate is regen + typecheck +
# the E2E exercising freshly-built bindings, not a byte-diff of committed output.
packages/abi/generated/

# cargo-component regenerates this from wit/ on every build
crates/kernel/src/bindings.rs
**/*.wasm
!wit/**/*.wasm
# Vendored v86 emulator runtime (M5) — committed third-party binaries, GPLv2.
!third_party/v86/*.wasm

# Zig compilation cache (build:guests:zig) — build output, not source
.zig-cache

# Test output
/playwright-report
/test-results
/coverage

# OS
.DS_Store

# Local-only / session + scratch
development/reference_only
.claude/

# Vite production build of the web client (build output)
apps/web/dist
